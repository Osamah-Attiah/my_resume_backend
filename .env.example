# Local development only. Copy to .env and replace values outside source control.
POSTGRES_DB=my_resume
POSTGRES_USER=resume_local
POSTGRES_PASSWORD=resume_local_password
ConnectionStrings__DefaultConnection=Host=localhost;Port=54324;Database=my_resume;Username=resume_local;Password=resume_local_password
Auth__SigningKey=replace-with-at-least-32-random-characters
Auth__Issuer=resume-api
Auth__Audience=resume-admin
Cors__AdminOrigin=http://localhost:5173

# Optional GitHub workflow dispatch. Leave all unset to use the manual local flow.
# Publishing__GitHubOwner=your-github-owner
# Publishing__GitHubRepository=your-private-or-public-repository
# Publishing__GitHubToken=github-token-with-actions-write-only
# Publishing__GitHubWorkflow=publish-site.yml
# Publishing__GitHubRef=main
# Preferred GitHub keys (the Publishing__ aliases above remain accepted for compatibility):
# GitHub__Owner=your-github-owner
# GitHub__PublishRepository=public-product-repository
# GitHub__PublishWorkflow=publish-site.yml
# GitHub__PublishRef=main
# GitHub__PrivateExportRepository=private-operations-repository
# GitHub__PrivateExportWorkflow=export-private-pdf.yml
# GitHub__PrivateExportRef=main
# GitHub__ProductRepository=owner/public-product-repository
# GitHub__ProductRef=pinned-commit-sha
# GitHub__Token=github-fine-grained-token

# Optional public project image storage. Keep the API secret server-side only.
# Cloudinary__CloudName=cloud-name
# Cloudinary__ApiKey=api-key
# Cloudinary__ApiSecret=api-secret

# Leave unset for local Vite proxy. Set to the deployed API origin in the admin host.
# VITE_API_BASE_URL=https://api.example.invalid
# VITE_PUBLIC_SITE_URL=https://www.example.invalid

# Production-only names are documented in docs/DEPLOYMENT_AR.md. Never add values here.
